{
  "name": "webblocks",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --no-open",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "bun run test:baseline && bun run test:unit",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:visual": "vitest run --config vitest.config.ts --project visual --passWithNoTests",
    "pw:install": "playwright install",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --config vitest.storybook.config.ts --project storybook",
    "test:components": "bun run test:storybook",
    "test:all": "bun run test:baseline && bun run test:deployment && bun run test:static && bun run test:routing && bun run test:persistence-browser && bun run lint && bun run build && bun run test:unit && bun run test:storybook && bun run test:storybook-static && bun run test:multi-repository",
    "test:baseline": "bun test --timeout 120000 ./tests/baseline/*.test.mjs",
    "dev:pages": "vite --no-open --mode github-pages",
    "build:pages": "tsc -b && vite build --mode github-pages",
    "build:docker": "tsc -b && vite build --mode docker",
    "preview:pages": "vite preview --mode github-pages",
    "preview:docker": "vite preview --mode docker",
    "test:deployment": "bun test --timeout 420000 ./tests/deployment/vite-deployment.test.mjs",
    "test:routing": "bun test --timeout 420000 ./tests/deployment/routing-browser.test.mjs",
    "test:nginx": "bun test --timeout 420000 ./tests/deployment/nginx-routing.test.mjs",
    "test:persistence": "bun test --timeout 120000 ./tests/baseline/persistence.test.mjs",
    "test:persistence-browser": "bun test --timeout 420000 ./tests/deployment/persistence-browser.test.mjs",
    "test:editor-config": "bun test --timeout 120000 ./tests/baseline/editor-config.test.mjs",
    "test:static": "bun test --timeout 420000 ./tests/deployment/static-deployment.test.mjs",
    "verify:static": "bun scripts/verify-static.mjs",
    "typecheck": "tsc -b",
    "assemble:pages": "bun scripts/assemble-pages.mjs",
    "verify:pages": "bun scripts/verify-static.mjs --pages --require-manifest",
    "test:storybook-static": "bun test --timeout 420000 ./tests/deployment/storybook-static.test.mjs",
    "init:site": "bun scripts/init-site.mjs",
    "test:template": "bun test --timeout 120000 ./tests/baseline/repository-template.test.mjs",
    "pack:framework": "bun scripts/pack-framework.mjs",
    "test:package": "bun test --timeout 120000 ./tests/baseline/framework-package.test.mjs",
    "test:package-consumer": "bun test --timeout 420000 ./tests/deployment/package-consumer.test.mjs",
    "test:multi-repository": "bun test --timeout 1200000 ./tests/deployment/multi-repository.test.mjs",
    "test:security": "bun test --timeout 120000 ./tests/baseline/security-review.test.mjs",
    "security:inventory": "bun scripts/security-review.mjs",
    "security:sbom": "bun scripts/bun-sbom.mjs",
    "security:audit": "bun scripts/bun-audit.mjs",
    "security:artifact": "bun scripts/security-review.mjs --artifact",
    "security:legal": "bun scripts/prepare-legal.mjs",
    "verify:browsers": "bun scripts/verify-browsers.mjs",
    "release:pack": "bun scripts/pack-release.mjs pack",
    "release:verify": "bun scripts/pack-release.mjs verify",
    "test:release": "bun test --timeout 120000 ./tests/baseline/release-package.test.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "nanoid": "5.1.16",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-redux": "^9.2.0",
    "react-router": "7.18.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@react-router/dev": "7.18.7",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-docs": "10.6.8",
    "@storybook/addon-vitest": "10.6.8",
    "@storybook/react-vite": "10.6.8",
    "@types/bun": "latest",
    "@types/node": "^24.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/browser-preview": "4.1.12",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "playwright": "^1.58.2",
    "sass": "^1.97.3",
    "storybook": "10.6.8",
    "typescript": "~5.7.3",
    "typescript-eslint": "8.74.0",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "vitest-browser-react": "2.3.0"
  },
  "license": "GPL-3.0-or-later",
  "overrides": {
    "@storybook/react-vite>@joshwooding/vite-plugin-react-docgen-typescript": "0.9.1"
  },
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": "1.4.5"
  }
}
