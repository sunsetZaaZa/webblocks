{
  "name": "reactwebsiteeditor",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --no-open",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:visual": "vitest run --config vitest.config.ts --project visual",
    "pw:install": "playwright install",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --config vitest.storybook.config.ts --project storybook",
    "test:components": "npm run test:storybook",
    "test:all": "npm run lint && npm run build && npm run test:unit && npm run test:storybook"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "nanoid": "^5.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-redux": "^9.2.0",
    "react-router": "^7.13.1",
    "redux-persist": "^6.0.0",
    "reduxjs-toolkit-persist": "^7.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@react-router/dev": "^7.13.1",
    "@storybook/addon-a11y": "10.3.6",
    "@storybook/addon-docs": "10.3.6",
    "@storybook/addon-vitest": "10.3.6",
    "@storybook/react-vite": "10.3.6",
    "@types/bun": "latest",
    "@types/node": "^24.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/browser-preview": "^4.0.18",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "playwright": "^1.58.2",
    "sass": "^1.97.3",
    "storybook": "10.3.6",
    "typescript": "~5.7.3",
    "typescript-eslint": "8.59.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vitest-browser-react": "^2.0.5"
  },
  "license": "GPL-3.0-or-later"
}
