# Copy to .env.github-pages.local for local Pages builds and previews.
# The named Vite mode already selects the github-pages deployment profile.
# Optional if repository.owner/name are already set in webblocks.config.json.
# Replace with the repository that will host this site, not necessarily Webblocks.
# If both sources are set, they must agree.
GITHUB_REPOSITORY=owner/repository
# auto derives /repository/ or / for owner.github.io.
# Set / for a custom domain root, or the exact path from configure-pages.
WEBBLOCKS_BASE_PATH=auto
